{
  "name": "apidoc",
  "version": "0.17.6",
  "description": "RESTful web API Documentation Generator",
  "author": "Peter Rottmann <rottmann@inveris.de>",
  "license": "MIT",
  "preferGlobal": true,
  "bin": "bin/apidoc",
  "main": "./lib/index.js",
  "homepage": "https://apidocjs.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/apidoc/apidoc.git"
  },
  "bugs": {
    "url": "https://github.com/apidoc/apidoc/issues"
  },
  "scripts": {
    "test": "npm run jshint && mocha test/",
    "jshint": "jshint lib/ test/",
    "build-example": "bin/apidoc -i example/ -o tmp/",
    "check-updates": "npm-check-updates"
  },
  "keywords": [
    "api",
    "apidoc",
    "doc",
    "documentation",
    "rest",
    "restful"
  ],
  "engines": {
    "node": ">= 0.10.0"
  },
  "dependencies": {
    "apidoc-core": "^0.11.1",
    "fs-extra": "^11.2.0",
    "lodash": "^4.17.21",
    "markdown-it": "^12.3.2",
    "yargs": "^17.7.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "apidoc-example": "*",
    "jshint": "^2.13.6",
    "mocha": "^10.2.0",
    "npm-check-updates": "^16.14.15",
    "path-to-regexp": "^6.2.0",
    "semver": "^7.5.4",
    "should": "^13.2.3",
    "webfontloader": "^1.6.28"
  },
  "jshintConfig": {
    "camelcase": true,
    "curly": false,
    "eqeqeq": true,
    "forin": true,
    "latedef": false,
    "newcap": true,
    "undef": true,
    "unused": true,
    "trailing": true,
    "node": true,
    "browser": true,
    "predef": [
      "it",
      "describe",
      "before",
      "after"
    ]
  }
}
